{
  "name": "douyin-media-studio",
  "version": "3.0.0",
  "description": "Windows desktop application for archiving authorized public social media",
  "main": "electron/main.js",
  "author": "iTakatox",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:backend": "pyinstaller --noconfirm --clean --onedir --windowed --name MediaArchiveBackend --add-data \"templates;templates\" --add-data \"static;static\" --add-data \"scan_worker.py;.\" --add-data \"comments_worker.py;.\" --add-data \"generic_worker.py;.\" --add-data \"platforms.py;.\" app.py",
    "dist": "npm run build:backend && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.itakatox.douyinmediastudio",
    "productName": "多平台媒体归档",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/MediaArchiveBackend",
        "to": "backend"
      },
      {
        "from": "setup.ps1",
        "to": "setup.ps1"
      },
      {
        "from": "app-icon-v2.ico",
        "to": "app-icon-v2.ico"
      }
    ],
    "win": {
      "icon": "app-icon-v2.ico",
      "target": "nsis",
      "artifactName": "MediaArchiveStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "app-icon-v2.ico",
      "uninstallerIcon": "app-icon-v2.ico",
      "installerHeaderIcon": "app-icon-v2.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "多平台媒体归档",
      "runAfterFinish": true
    }
  }
}
